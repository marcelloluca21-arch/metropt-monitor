# Copy this file to .env and fill in real values. Never commit .env.

# Used by the postgres container on first initialisation of the volume
POSTGRES_DB=postgres
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# Used by the Python pipeline to reach the server from the host
DB_HOST=localhost
DB_PORT=5432

# Separate database used only by the integration tests
POSTGRES_DB_TEST=metropt_test
